<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("./partials/head") %>
    <title>Add Blog</title>
  </head>
  <body>
    <%- include("./partials/nav") %>

    <div class="container mt-4">
      <div class="row">
        <div class="col-md-8 offset-md-2">
          <h1><%= blog.title %></h1>
          <% if (blog.coverImage) { %>
          <img
            src="/<%= blog.coverImage %>"
            alt="<%= blog.title %>"
            class="img-fluid mb-3"
          />
          <% } %>
          <pre><%= blog.body %></pre>
        </div>
      </div>

     <%- include("./partials/scripts") %>
  </body>
</html>